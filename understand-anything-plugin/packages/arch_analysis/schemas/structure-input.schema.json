      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "sizeLines": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sizelines"
        },
        "fileCategory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filecategory"
        }
      },
      "required": [
        "path"
      ],
      "title": "StructureBatchFile",
      "type": "object"
    }
  },
  "description": "Input contract for :mod:`arch_analysis.extract_structure`.\n\n``batchImportData`` maps a file path to its pre-resolved relative import\ntargets (used for ``metrics.importCount``).",
