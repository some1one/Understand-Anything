{
  "$defs": {
    "DomainNode": {
      "additionalProperties": true,
      "description": "A domain-graph node \u2014 restricted to ``domain``/``flow``/``step``.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "domain",
            "flow",
            "step"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "complexity": {
          "enum": [
            "simple",
            "moderate",
            "complex"
          ],
          "title": "Complexity",
          "type": "string"
        },
        "filePath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filepath"
        },
        "lineRange": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linerange"
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "summary",
        "tags",
        "complexity"
      ],
      "title": "DomainNode",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": true,
      "description": "A directed, typed, weighted edge in an assembled graph or fragment.",
      "properties": {
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "type": {
          "enum": [
            "imports",
            "exports",
            "contains",
            "inherits",
            "implements",
            "calls",
            "subscribes",
            "publishes",
            "middleware",
            "reads_from",
            "writes_to",
            "transforms",
            "validates",
            "depends_on",
            "tested_by",
            "configures",
            "related",
            "similar_to",
            "deploys",
            "serves",
            "provisions",
            "triggers",
            "migrates",
            "documents",
            "routes",
            "defines_schema",
            "contains_flow",
            "flow_step",
            "cross_domain"
          ],
          "title": "Type",
          "type": "string"
        },
        "direction": {
          "default": "forward",
          "enum": [
            "forward",
            "backward",
            "bidirectional"
          ],
          "title": "Direction",
          "type": "string"
        },
        "weight": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "source",
        "target",
        "type",
        "weight"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphProject": {
      "additionalProperties": true,
      "description": "Project metadata block shared by knowledge and domain graphs.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "frameworks": {
          "items": {
            "type": "string"
          },
          "title": "Frameworks",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "analyzedAt": {
          "title": "Analyzedat",
          "type": "string"
        },
        "gitCommitHash": {
          "title": "Gitcommithash",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "analyzedAt",
        "gitCommitHash"
      ],
      "title": "GraphProject",
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "description": "A single architecture layer in the Phase 2 output.",
      "properties": {
        "id": {
          "pattern": "^layer:[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "nodeIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Nodeids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "nodeIds"
      ],
      "title": "Layer",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "The domain-graph contract (``domain-graph.json``).\n\nNodes are restricted to domain/flow/step types and ``layers`` is empty by\nconvention (the dashboard renders domain graphs with a layer-free view).",
  "properties": {
    "version": {
      "title": "Version",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/GraphProject"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/DomainNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "title": "Layers",
      "type": "array"
    }
  },
  "required": [
    "version",
    "project",
    "nodes",
    "edges"
  ],
  "title": "DomainGraph",
  "type": "object"
}
